<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">

    <div class="module-title">
        <h1 class="module-heading">Edit Artist</h1>
    </div>

    <div class="form-card">

        <div id="artistMessage"></div>

        <form id="editArtistForm">

            <input type="hidden" id="artist_id">

            <div class="mb-3">
                <label class="form-label">Artist Name</label>
                <input type="text" id="artist_name" class="form-control">
            </div>

            <div class="mb-3">
                <label class="form-label">Gender</label>
                <select id="gender" class="form-control">
                    <option value="">Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Artist Description (Optional)</label>
                <textarea id="description" class="form-control" rows="3" placeholder="Enter artist description..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Login Email</label>
                <input type="email" id="email" class="form-control">
            </div>

            <div class="mb-3">
                <label class="form-label">Login Password (Leave blank to keep unchanged)</label>
                <input type="password" id="password" class="form-control" onmouseover="this.type='text'" onmouseout="this.type='password'">
            </div>

            <% if (admin && admin.role !== 'artist') { %>
            <div class="mb-3">
                <label class="form-label">Join Date</label>
                <input type="date" id="join_date" class="form-control">
            </div>

            <div class="mb-3">
                <label class="form-label">Monthly Salary (₹)</label>
                <input type="number" step="0.01" id="salary" class="form-control">
            </div>
            <% } %>

            <button type="submit" class="submit-btn">
                Update Artist
            </button>

        </form>

    </div>

</div>

<script src="/admin/js/artist.js"></script>

<%- include('../partials/footer') %>
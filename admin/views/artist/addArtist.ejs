<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">

    <div class="module-title">
        <h1 class="module-heading">Add Artist</h1>
    </div>

    <div class="form-card">

        <div id="artistMessage"></div>

        <form id="addArtistForm">

            <div class="mb-3">
                <label class="form-label">Artist Name</label>
                <input type="text" name="artist_name" id="artist_name" class="form-control" placeholder="Enter artist name">
            </div>

            <div class="mb-3">
                <label class="form-label">Gender</label>
                <select name="gender" id="gender" class="form-control">
                    <option value="">Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Login Email</label>
                <input type="email" name="email" id="email" class="form-control" placeholder="Enter artist login email">
            </div>

            <div class="mb-3">
                <label class="form-label">Login Password</label>
                <input type="password" name="password" id="password" class="form-control" placeholder="Enter artist login password">
            </div>

            <div class="mb-3">
                <label class="form-label">Artist Description (Optional)</label>
                <textarea name="description" id="description" class="form-control" rows="3" placeholder="Enter artist description..."></textarea>
            </div>

            <!-- Only Admin should add salary ideally, but let's just add it -->
            <% if (admin && admin.role !== 'artist') { %>
            <div class="mb-3">
                <label class="form-label">Join Date</label>
                <input type="date" name="join_date" id="join_date" class="form-control" placeholder="Select join date">
            </div>

            <div class="mb-3">
                <label class="form-label">Monthly Salary (₹)</label>
                <input type="number" step="0.01" name="salary" id="salary" class="form-control" placeholder="Enter artist salary">
            </div>
            <% } %>

            <button type="submit" class="submit-btn">
             Add Artist
            </button>

        </form>

    </div>

</div>

<script src="/admin/js/addArtist.js"></script>
<script src="/admin/js/artist.js"></script>


<%- include('../partials/footer') %>
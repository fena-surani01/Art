<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content">
    <div class="module-title d-flex justify-content-between align-items-center">
        <h2 class="module-heading"><i class="bi bi-map"></i> Manage States</h2>
        <button class="btn btn-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addStateModal">
            <i class="bi bi-plus-lg me-1"></i> Add State
        </button>
    </div>

    <div class="table-card mt-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th width="10%">ID</th>
                        <th width="50%">State Name</th>
                        <th width="20%">Status</th>
                        <th width="20%" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (states && states.length > 0) { %>
                        <% states.forEach(state => { %>
                            <tr>
                                <td>#<%= state.id %></td>
                                <td class="fw-bold"><%= state.state_name %></td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input toggle-state-status" type="checkbox" role="switch" 
                                               data-id="<%= state.id %>" <%= (state.is_active === 1 || state.is_active === true || state.is_active === undefined) ? 'checked' : '' %> style="cursor: pointer; transform: scale(1.2);">
                                        <label class="form-check-label fw-semibold ms-2 <%= (state.is_active === 1 || state.is_active === true || state.is_active === undefined) ? 'text-success' : 'text-danger' %>">
                                            <%= (state.is_active === 1 || state.is_active === true || state.is_active === undefined) ? 'Active' : 'Inactive' %>
                                        </label>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger delete-state-btn" data-id="<%= state.id %>">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">No states found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add State Modal -->
<div class="modal fade" id="addStateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="addStateForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add New State</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">State Name</label>
                        <input type="text" class="form-control" name="state_name" required placeholder="e.g. Gujarat">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Add State</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('addStateForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const btn = this.querySelector('button[type="submit"]');
    btn.disabled = true;
    
    fetch('/admin/api/locations/states/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ state_name: this.state_name.value })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.message);
            btn.disabled = false;
        }
    })
    .catch(err => {
        alert('Error adding state');
        btn.disabled = false;
    });
});

document.querySelectorAll('.delete-state-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        if (!confirm('Are you sure? This might fail if there are cities linked to this state.')) return;
        
        const id = this.getAttribute('data-id');
        this.disabled = true;
        
        fetch(`/admin/api/locations/states/${id}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
            if (data.success) window.location.reload();
            else { alert(data.message); this.disabled = false; }
        });
    });
});

document.querySelectorAll('.toggle-state-status').forEach(toggle => {
    toggle.addEventListener('change', function() {
        const id = this.getAttribute('data-id');
        const label = this.nextElementSibling;
        
        fetch(`/admin/api/locations/states/toggle/${id}`, { method: 'PUT' })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (this.checked) {
                    label.innerText = 'Active';
                    label.className = 'form-check-label fw-semibold ms-2 text-success';
                } else {
                    label.innerText = 'Inactive';
                    label.className = 'form-check-label fw-semibold ms-2 text-danger';
                }
            } else {
                alert(data.message || 'Error updating status');
                this.checked = !this.checked;
            }
        })
        .catch(() => {
            alert('Error updating status');
            this.checked = !this.checked;
        });
    });
});
</script>

<%- include('partials/footer') %>

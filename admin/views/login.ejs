<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Art Office - Admin Login</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            margin: 0;
            height: 100vh;
            background: #F5F7FA;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
        }

        .login-box {
            width: 100%;
            max-width: 480px;
            background: #ffffff;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            position: relative;
        }

        /* 🔥 Top Accent Border */
        .login-box::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            height: 4px;
            width: 100%;
            background: linear-gradient(to right, #1E3A5F, #2C4E73);
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .login-title {
            text-align: center;
            margin-bottom: 25px;
        }

        .login-title h4 {
            color: #1E3A5F;
            font-weight: 600;
        }

        .login-title p {
            font-size: 14px;
            color: #6c757d;
        }

        .form-control {
            height: 45px;
            border-radius: 6px;
        }

        /* ✨ Input focus subtle glow */
        .form-control:focus {
            border-color: #2C4E73;
            box-shadow: 0 0 6px rgba(44, 78, 115, 0.2);
        }

        /* 🔘 Button */
        .btn-login {
            background: #1E3A5F;
            color: #fff;
            height: 45px;
            border: none;
            font-weight: 500;
            border-radius: 6px;
            transition: all 0.2s ease-in-out;
        }

        .btn-login:hover {
            background: #152943;
            color: #fff;
            box-shadow: 0 4px 8px rgba(30, 58, 95, 0.2);
        }

        .footer-text {
            text-align: center;
            font-size: 13px;
            color: #999;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="login-box">

        <div class="login-title">
            <h4>Art Office</h4>
            <!-- <p>Admin Panel Login</p> -->
        </div>

        <div id="loginMessage"></div>

        <form id="loginForm">

            <div class="mb-3">
                <label>Login As</label>
                <select name="role" class="form-select form-control">
                    <option value="admin" selected>Admin</option>
                    <option value="artist">Artist</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="Enter email">
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter password">
            </div>

            <button type="submit" class="btn btn-login w-100">Login</button>

        </form>

        <div class="footer-text">
            © 2026 Art Office
        </div>

    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = this.querySelector('button[type="submit"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Logging in...';
            btn.disabled = true;

            const role = document.querySelector('select[name="role"]').value;
            const email = document.querySelector('input[name="email"]').value;
            const password = document.querySelector('input[name="password"]').value;
            const messageDiv = document.getElementById('loginMessage');

            try {
                const response = await fetch('/admin/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ role, email, password })
                });

                const data = await response.json();

                if (data.success) {
                    messageDiv.innerHTML = `<div class="alert alert-success d-flex align-items-center py-2 px-3 rounded-3 shadow-sm"><i class="bi bi-check-circle-fill me-2 fs-5"></i> <div><strong>Success:</strong> ${data.message}</div></div>`;
                    setTimeout(() => {
                        window.location.href = "/admin/dashboard";
                    }, 500);
                } else {
                    messageDiv.innerHTML = `<div class="alert alert-danger d-flex align-items-center py-2 px-3 rounded-3 shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i> <div><strong>Error:</strong> ${data.message}</div></div>`;
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (error) {
                console.error(error);
                messageDiv.innerHTML = `<div class="alert alert-danger d-flex align-items-center py-2 px-3 rounded-3 shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i> <div><strong>Error:</strong> An error occurred. Please try again.</div></div>`;
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });
    </script>
</body>
</html>
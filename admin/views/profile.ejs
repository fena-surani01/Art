<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content">
    <div class="module-title mb-4">
        <h2 class="module-heading fw-bold" style="color: var(--primary-blue, #294A70);">My Profile</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="official-card p-0 overflow-hidden" style="border-radius: 16px; border: 1px solid rgba(41, 74, 112, 0.1); box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
                
                <!-- Profile Header -->
                <div class="profile-header d-flex align-items-center p-4" style="background: linear-gradient(135deg, rgba(41, 74, 112, 0.05) 0%, rgba(58, 99, 148, 0.15) 100%); border-bottom: 1px solid rgba(41, 74, 112, 0.1); gap: 1.25rem;">
                    <% const displayName = (admin && admin.name) ? admin.name : (admin && admin.role === 'admin' ? 'Administrator' : 'User'); %>
                    <div style="width: 65px; height: 65px; border-radius: 50%; background: linear-gradient(135deg, #294A70, #3A6394); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.8rem; font-weight: 700; box-shadow: 0 4px 15px rgba(41, 74, 112, 0.3); text-transform: uppercase; flex-shrink: 0;">
                        <%= displayName.charAt(0) %>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1" style="color: #294A70; font-size: 1.4rem;"><%= displayName %></h4>
                        <span class="badge rounded-pill px-2 py-1" style="background-color: rgba(41, 74, 112, 0.1); color: #294A70; font-size: 0.8rem; font-weight: 600; text-transform: capitalize; border: 1px solid rgba(41, 74, 112, 0.2);">
                            <i class="bi bi-shield-check me-1"></i> <%= admin ? admin.role : '' %>
                        </span>
                    </div>
                </div>

                <!-- Profile Body -->
                <div class="profile-body p-5 bg-white">
                    <div class="row g-4">
                        
                        <div class="col-md-6">
                            <div class="d-flex align-items-start p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.05)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                <div class="icon-box me-3 mt-1" style="width: 45px; height: 45px; background: rgba(41, 74, 112, 0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #294A70;">
                                    <i class="bi bi-person-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="small text-muted fw-semibold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Full Name</div>
                                    <div class="fw-bold text-dark fs-5"><%= displayName %></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex align-items-start p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.05)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                <div class="icon-box me-3 mt-1" style="width: 45px; height: 45px; background: rgba(41, 74, 112, 0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #294A70;">
                                    <i class="bi bi-envelope-fill fs-4"></i>
                                </div>
                                <div style="overflow: hidden;">
                                    <div class="small text-muted fw-semibold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Email Address</div>
                                    <div class="fw-bold text-dark fs-5 text-truncate" title="<%= admin ? admin.email : '' %>"><%= admin ? admin.email : 'N/A' %></div>
                                </div>
                            </div>
                        </div>



                        <div class="col-md-6">
                            <div class="d-flex align-items-start p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.05)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                <div class="icon-box me-3 mt-1" style="width: 45px; height: 45px; background: rgba(41, 74, 112, 0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #294A70;">
                                    <i class="bi bi-key-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="small text-muted fw-semibold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Password</div>
                                    <div class="fw-bold text-dark fs-5">
                                        ********
                                    </div>
                                </div>
                            </div>
                        </div>

                        <% if (admin && admin.role === 'artist' && fullArtist) { %>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.05)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                <div class="icon-box me-3 mt-1" style="width: 45px; height: 45px; background: rgba(41, 74, 112, 0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #294A70;">
                                    <i class="bi bi-calendar-check-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="small text-muted fw-semibold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Join Date</div>
                                    <div class="fw-bold text-dark fs-5">
                                        <%= fullArtist.join_date ? new Date(fullArtist.join_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : (fullArtist.created_at ? new Date(fullArtist.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A') %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="d-flex align-items-start p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.05)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                <div class="icon-box me-3 mt-1" style="width: 45px; height: 45px; background: rgba(41, 74, 112, 0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #294A70;">
                                    <i class="bi bi-cash-stack fs-4"></i>
                                </div>
                                <div>
                                    <div class="small text-muted fw-semibold mb-1 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Monthly Salary</div>
                                    <div class="fw-bold text-success fs-5">
                                        <%= fullArtist.salary ? '₹' + parseFloat(fullArtist.salary).toLocaleString('en-IN') : '₹0' %>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>

                    </div>

                    <div class="text-center mt-5">
                        <button type="button" class="btn px-4 py-2 fw-bold" style="background-color: #294A70; color: white; border-radius: 8px; box-shadow: 0 4px 10px rgba(41, 74, 112, 0.3); transition: all 0.3s ease;" onmouseover="this.style.backgroundColor='#1a3250'; this.style.transform='translateY(-2px)';" onmouseout="this.style.backgroundColor='#294A70'; this.style.transform='translateY(0)';" onclick="openEditProfileModal()">
                            <i class="bi bi-pencil-square me-2"></i> Edit Profile Information
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header" style="background-color: #294A70; color: white; border-bottom: none;">
                <h5 class="modal-title fw-bold" id="editProfileModalLabel"><i class="bi bi-pencil-square me-2"></i>Edit Profile</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <form id="editProfileForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                            <input type="text" id="editName" class="form-control border-start-0" value="<%= (admin && admin.name && admin.name !== 'Administrator') ? admin.name : '' %>" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input type="email" id="editEmail" class="form-control border-start-0" value="<%= admin ? admin.email : '' %>" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <% const userPassword = (admin && admin.role === 'artist' && fullArtist && fullArtist.password_hash) ? fullArtist.password_hash : (admin && admin.password ? admin.password : ''); %>
                        <label class="form-label fw-bold text-dark">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input type="password" id="editPassword" class="form-control border-start-0" value="<%= userPassword %>" onmouseover="this.type='text'" onmouseout="this.type='password'" required>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-top-0 d-flex justify-content-between">
                <button type="button" class="btn btn-secondary px-4 fw-bold rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn px-4 fw-bold rounded-3" style="background-color: #294A70; color: white;" id="saveProfileBtn" onclick="submitProfileUpdate()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openEditProfileModal() {
        const modal = new bootstrap.Modal(document.getElementById('editProfileModal'));
        modal.show();
    }

    function submitProfileUpdate() {
        const name = document.getElementById('editName').value.trim();
        const email = document.getElementById('editEmail').value.trim();
        const password = document.getElementById('editPassword').value.trim();
        
        if (!name || !email) {
            if (typeof window.showActionToast === 'function') {
                window.showActionToast('profileError', 'Validation Error', 'Name and Email are required fields.', 'bi-exclamation-triangle-fill', 'danger');
            } else {
                alert('Name and Email are required fields.');
            }
            return;
        }

        const btn = document.getElementById('saveProfileBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...';

        const xhr = new XMLHttpRequest();
        xhr.open("PUT", "/admin/api/profile/update", true);
        xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
        xhr.onload = function() {
            btn.disabled = false;
            btn.innerHTML = 'Save Changes';
            
            try {
                const res = JSON.parse(xhr.responseText);
                if (res.success) {
                    if (typeof window.showActionToast === 'function') {
                        window.showActionToast('profileSuccess', 'Success', res.message, 'bi-check-circle-fill', 'success');
                    }
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    if (typeof window.showActionToast === 'function') {
                        window.showActionToast('profileError', 'Error', res.message, 'bi-x-circle-fill', 'danger');
                    }
                }
            } catch (e) {
                console.error(e);
                if (typeof window.showActionToast === 'function') {
                    window.showActionToast('profileError', 'Error', 'Something went wrong.', 'bi-x-circle-fill', 'danger');
                }
            }
        };
        xhr.send("name=" + encodeURIComponent(name) + "&email=" + encodeURIComponent(email) + "&password=" + encodeURIComponent(password));
    }
</script>

<%- include('partials/footer') %>

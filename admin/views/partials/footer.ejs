<div class="footer">
    © 2026 Fenaria Admin Panel
</div>

<!-- Global Confirm Modal -->
<div class="modal fade" id="globalConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold" id="globalConfirmTitle">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p id="globalConfirmMessage" class="fs-5 text-muted mb-0">Are you sure?</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn" id="globalConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    window.showConfirmModal = function(title, message, btnText, btnClass, callback) {
        document.getElementById('globalConfirmTitle').innerHTML = title;
        document.getElementById('globalConfirmMessage').innerHTML = message;
        
        const confirmBtn = document.getElementById('globalConfirmBtn');
        confirmBtn.innerHTML = btnText;
        confirmBtn.className = 'btn ' + btnClass;
        
        // Remove old event listeners
        const newConfirmBtn = confirmBtn.cloneNode(true);
        confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
        
        const modalEl = document.getElementById('globalConfirmModal');
        const modal = new bootstrap.Modal(modalEl);
        
        newConfirmBtn.addEventListener('click', function() {
            modal.hide();
            if (callback) callback();
        });
        
        modal.show();
    };

    // Notification Logic
    document.addEventListener('DOMContentLoaded', () => {
        function fetchNotifications() {
            fetch('/admin/api/notifications')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.notifications) {
                        const notifs = data.notifications;
                        
                        <% if (admin && admin.role === 'artist') { %>
                            const unreadCount = notifs.length;
                            
                            if (unreadCount > 0) {
                                const customBadge = document.getElementById('custom-badge');
                                if (customBadge) {
                                    customBadge.textContent = unreadCount;
                                    customBadge.style.display = 'inline-block';
                                }
                                
                                // Only show a new toast if the count has increased or we haven't shown it yet
                                if (!window['last_notif_count'] || unreadCount > window['last_notif_count']) {
                                    window['last_notif_count'] = unreadCount;
                                    
                                    if (window.playNotificationSound) window.playNotificationSound();
                                    
                                    if (window.showNotificationToast) {
                                        window.showNotificationToast(
                                            'db_grouped', 
                                            'New Notifications', 
                                            `You have <span class="fw-bold">${unreadCount} unread notification(s)</span> pending!`, 
                                            'bi-bell-fill', 
                                            'info', 
                                            () => {
                                                // Mark all as read only when user manually dismisses it
                                                fetch('/admin/api/notifications/mark-all-read', { method: 'POST' });
                                                window['last_notif_count'] = 0;
                                                const customBadge = document.getElementById('custom-badge');
                                                if (customBadge) customBadge.style.display = 'none';
                                            }
                                        );
                                        
                                        // If artist gets a new notification, gently reload their dashboard/requests to reflect the new assignment
                                        if (window.location.pathname.includes('/admin/dashboard') || window.location.pathname === '/admin/custom-requests/view' || window.location.pathname === '/admin/') {
                                            setTimeout(() => { if (window.silentPageReload) window.silentPageReload(); }, 2000);
                                        }
                                    }
                                }
                            } else {
                                window['last_notif_count'] = 0;
                                const customBadge = document.getElementById('custom-badge');
                                if (customBadge) customBadge.style.display = 'none';
                            }
                        <% } else { %>
                            notifs.forEach(notif => {
                                // Prevent re-showing the same notification on the same page load every 5 seconds
                                if (!window['notif_shown_' + notif.id]) {
                                    window['notif_shown_' + notif.id] = true;
                                    
                                    if (window.playNotificationSound) window.playNotificationSound();
                                    
                                    if (window.showNotificationToast) {
                                        window.showNotificationToast(
                                            'db_' + notif.id, 
                                            notif.title, 
                                            notif.message, 
                                            'bi-bell-fill', 
                                            'info', 
                                            () => {
                                                // Mark as read only when user manually dismisses it
                                                fetch('/admin/api/notifications/mark-read/' + notif.id, { method: 'POST' });
                                            }
                                        );
                                        
                                        // If admin gets artist status update and is on custom requests view, auto reload table
                                        if (notif.title === 'Artist Status Updated' && window.location.pathname === '/admin/custom-requests/view') {
                                            setTimeout(() => { if (window.silentPageReload) window.silentPageReload(); }, 2000);
                                        }
                                    }
                                }
                            });
                        <% } %>
                    }
                })
                .catch(console.error);
        }

        // Global Silent Reload Utility for fully dynamic UX without full page reloads
        window.silentPageReload = function() {
            fetch(window.location.href)
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    // 1. Update Table containers
                    const newTable = doc.querySelector('.table-responsive');
                    const oldTable = document.querySelector('.table-responsive');
                    if (newTable && oldTable) {
                        oldTable.innerHTML = newTable.innerHTML;
                    }
                    
                    // 2. Refresh dashboard if available
                    if (typeof fetchDashboardStats === 'function') {
                        const filterSelect = document.getElementById('dateFilter');
                        fetchDashboardStats(filterSelect ? filterSelect.value : 'today');
                    }
                    
                    // 3. Re-attach necessary JS events
                    if (typeof window.attachCustomRequestEvents === 'function') window.attachCustomRequestEvents();
                    if (typeof window.attachOrderEvents === 'function') window.attachOrderEvents();
                    
                    // 4. Cleanup modals overlay
                    document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                    document.body.classList.remove('modal-open');
                    document.body.style.overflow = '';
                    document.body.style.paddingRight = '';
                })
                .catch(err => console.error("Silent reload failed", err));
        };

        // Fetch immediately and poll every 5 seconds
        fetchNotifications();
        setInterval(fetchNotifications, 5000);
    });
</script>
</body>
</html>
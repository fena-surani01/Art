        <i class="bi bi-speedometer2"></i>
        Dashboard
    </a>

    <% if (admin && admin.role !== 'artist') { %>
        <h6 class="sidebar-heading px-3 mt-4 mb-2 text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">People Management</h6>
    <% } %>


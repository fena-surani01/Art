        </div>
    <% } %>

    <% if (admin && admin.role !== 'artist') { %>
        <h6 class="sidebar-heading px-3 mt-4 mb-2 text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">Art Management</h6>
        
        <!-- Art Images Menu (Admin Only) -->

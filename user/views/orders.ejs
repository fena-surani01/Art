<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fenaria - My Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .order-card {
            border-radius: 15px;
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            background: #fff;
            overflow: hidden;
        }
        .order-header {
            background: #f8f9fa;
            padding: 1.5rem;
            border-bottom: 1px solid #e9ecef;
        }
        
        /* Timeline Styles */
        .tracking-timeline {
            display: flex;
            justify-content: space-between;
            position: relative;
            margin: 2rem 0;
            padding: 0 1rem;
        }
        .tracking-timeline::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 10%;
            right: 10%;
            height: 4px;
            background: #e9ecef;
            z-index: 1;
            border-radius: 4px;
        }
        .timeline-step {
            position: relative;
            z-index: 2;
            text-align: center;
            width: 25%;
        }
        .timeline-icon {
            width: 44px;
            height: 44px;
            background: #fff;
            border: 4px solid #e9ecef;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            color: #adb5bd;
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }
        .timeline-text {
            font-size: 0.85rem;
            font-weight: 600;
            color: #6c757d;
        }
        
        /* Active States */
        .timeline-step.active .timeline-icon {
            border-color: #2C3E50;
            color: #2C3E50;
        }
        .timeline-step.active .timeline-text {
            color: #2C3E50;
        }
        .timeline-step.completed .timeline-icon {
            background: #2C3E50;
            border-color: #2C3E50;
            color: #fff;
        }
        
        /* Dynamic Progress Bar */
        .tracking-progress {
            position: absolute;
            top: 20px;
            left: 10%;
            height: 4px;
            background: #2C3E50;
            z-index: 1;
            transition: width 0.5s ease;
        }

        /* Order Filter Tabs */
        .order-tabs .nav-link {
            border-radius: 50rem;
            color: #6c757d;
            font-weight: 600;
            padding: 0.6rem 1.5rem;
            margin: 0 0.25rem;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            background-color: transparent;
        }
        .order-tabs .nav-link:hover {
            color: #2C3E50 !important;
            background-color: #e9ecef !important;
        }
        .order-tabs .nav-link.active {
            color: #fff !important;
            background-color: #2C3E50 !important;
            box-shadow: 0 4px 10px rgba(44, 62, 80, 0.2) !important;
        }
        
        .review-btn-hover {
            transition: all 0.3s ease;
        }
        .review-btn-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15) !important;
            background-color: #1a252f !important;
        }
    </style>
</head>
<body style="background-color: #f4f6f8;">
    <%- include('partials/navbar') %>

    <section class="container py-5">
        <div class="text-center mb-5">
            <h2 class="section-title">My <span class="section-highlight">Orders</span></h2>
        </div>

        <!-- Filter Tabs & Dropdowns -->
        <div class="d-flex justify-content-center mb-4 flex-wrap gap-3 align-items-center">
            <ul class="nav nav-pills order-tabs">
                <li class="nav-item"><a class="nav-link active" id="order-tab" href="#" onclick="switchTab('order', this); return false;">Order Art</a></li>
                <li class="nav-item"><a class="nav-link" id="custom-tab" href="#" onclick="switchTab('custom', this); return false;">Custom Art</a></li>
            </ul>
            
            <div class="dropdown">
                <button class="btn btn-outline-dark dropdown-toggle" type="button" id="statusFilterBtn" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 50px; padding: 8px 20px; font-weight: 500;">
                    Filter: <span id="currentFilterText">All</span>
                </button>
                <ul class="dropdown-menu shadow border-0" id="filterDropdownMenu" aria-labelledby="statusFilterBtn">
                    <!-- Populated by JS -->
                </ul>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10" id="orders-container">
                <% if (orders && orders.length > 0) { %>
                    <% orders.forEach(order => { %>
                        <% 
                            const orderDate = new Date(order.created_at);
                            const estDelivery = new Date(orderDate);
                            estDelivery.setDate(estDelivery.getDate() + 5);
                            
                            // Map status to timeline index
                            const statuses = ['Pending', 'Processing', 'Shipped', 'Delivered'];
                            let currentStepIndex = statuses.indexOf(order.status);
                            if (currentStepIndex === -1 && order.status === 'Cancelled') {
                                currentStepIndex = -1; // Handle cancelled uniquely
                            }
                            
                            // Calculate progress bar width
                            // 0 = 0%, 1 = 33%, 2 = 66%, 3 = 100%
                            let progressWidth = 0;
                            if(currentStepIndex > 0) progressWidth = (currentStepIndex / 3) * 80; // 80 is the width space between left 10% and right 10%
                            
                            // Determine Card Border
                            let borderClass = '';
                            if (order.status === 'Cancelled') borderClass = 'border-start border-5 border-danger';
                            else if (order.status === 'Delivered') borderClass = 'border-start border-5 border-success';
                            else borderClass = 'border-start border-5 border-warning'; // Pending, Processing, Shipped
                        %>
                        <div class="order-card <%= borderClass %>" id="order-card-<%= order.order_id %>" data-status="<%= order.status %>">
                            <!-- Header (Clickable for Collapse) -->
                            <div class="order-header d-flex flex-wrap justify-content-between align-items-center"
                                 style="cursor: pointer;" 
                                 data-bs-toggle="collapse" 
                                 data-bs-target="#collapse-order-<%= order.order_id %>" 
                                 aria-expanded="false">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark d-flex align-items-center">
                                        Order #ORD-<%= order.order_id %>
                                        <i class="bi bi-chevron-down ms-2 fs-6 text-muted"></i>
                                    </h5>
                                    <small class="text-muted">Placed on <%= orderDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></small>
                                </div>
                                <div class="text-end mt-2 mt-sm-0">
                                    <h4 class="text-dark fw-bold mb-0">₹<%= order.total_amount %></h4>
                                    <span class="badge <%= order.status === 'Cancelled' ? 'bg-danger' : (order.status === 'Delivered' ? 'bg-success' : 'bg-warning text-dark') %> px-3 py-2 mt-1 shadow-sm">
                                        <%= order.status.toUpperCase() %>
                                    </span>
                                </div>
                            </div>

                            <div class="collapse" id="collapse-order-<%= order.order_id %>">
                                <div class="card-body p-4 p-md-5">
                                <% if (order.status !== 'Cancelled') { %>
                                    <!-- Tracking Timeline -->
                                    <div class="tracking-timeline d-none d-md-flex">
                                        <div class="tracking-progress" style="width: <%= progressWidth %>%;"></div>
                                        
                                        <div class="timeline-step <%= currentStepIndex >= 0 ? 'completed' : '' %> <%= currentStepIndex === 0 ? 'active' : '' %>">
                                            <div class="timeline-icon"><i class="bi bi-cart-check"></i></div>
                                            <div class="timeline-text">Order Placed</div>
                                        </div>
                                        <div class="timeline-step <%= currentStepIndex >= 1 ? 'completed' : '' %> <%= currentStepIndex === 1 ? 'active' : '' %>">
                                            <div class="timeline-icon"><i class="bi bi-box-seam"></i></div>
                                            <div class="timeline-text">Processing</div>
                                        </div>
                                        <div class="timeline-step <%= currentStepIndex >= 2 ? 'completed' : '' %> <%= currentStepIndex === 2 ? 'active' : '' %>">
                                            <div class="timeline-icon"><i class="bi bi-truck"></i></div>
                                            <div class="timeline-text">Shipped</div>
                                        </div>
                                        <div class="timeline-step <%= currentStepIndex >= 3 ? 'completed' : '' %> <%= currentStepIndex === 3 ? 'active' : '' %>">
                                            <div class="timeline-icon"><i class="bi bi-house-door"></i></div>
                                            <div class="timeline-text">Delivered</div>
                                        </div>
                                    </div>
                                    
                                    <div class="text-center mb-4 mt-2">
                                        <% if (order.status === 'Delivered') { %>
                                            <!-- Do not show estimated delivery if already delivered -->
                                        <% } else if (order.status === 'Return Requested') { %>
                                            <% if (order.estimated_pickup) { %>
                                            <div class="badge bg-warning bg-opacity-10 text-dark border border-warning p-2 fs-6 rounded-pill shadow-sm">
                                                <i class="bi bi-truck text-warning me-2"></i>
                                                Estimated Pickup: <span class="fw-bold"><%= new Date(order.estimated_pickup).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
                                            </div>
                                            <% } %>
                                        <% } else { %>
                                            <div class="badge bg-light text-dark border p-2">
                                                <i class="bi bi-calendar-event text-primary me-2"></i>
                                                Estimated Delivery: <span class="fw-bold"><%= estDelivery.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></span>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>

                                <!-- Order Details & Items -->
                                <div class="row mt-5">
                                    <div class="col-md-7 mb-4 mb-md-0">
                                        <div class="p-4 rounded-4 h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                            <h6 class="fw-bold text-uppercase text-muted small mb-3">Items Ordered</h6>
                                            <% if (order.items && order.items.length > 0) { %>
                                                <div class="list-group list-group-flush bg-transparent">
                                                    <% order.items.forEach(item => { %>
                                                        <div class="list-group-item bg-transparent px-0 py-3 d-flex align-items-center" style="border-color: #e2e8f0;">
                                                        <img src="<%= item.image_path || '/images/default-art.jpg' %>" alt="<%= item.title %>" style="width: 70px; height: 70px; object-fit: cover; border-radius: 10px;" class="me-3 shadow-sm">
                                                        <div class="flex-grow-1">
                                                            <h6 class="mb-0 fw-bold"><%= item.title %></h6>
                                                            <small class="text-muted"><%= item.artist_name || 'Unknown Artist' %></small>
                                                            <div class="mt-1 small">
                                                                <span class="badge bg-secondary"><%= item.art_type || 'Art' %></span>
                                                            </div>
                                                        </div>
                                                        <div class="text-end">
                                                            <div class="fw-bold">₹<%= item.price %></div>
                                                            <small class="text-muted d-block mb-2">Qty: <%= item.quantity %></small>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <p class="text-muted">No items found.</p>
                                        <% } %>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-5">
                                        <div class="bg-light p-4 rounded-4 h-100">
                                            <h6 class="fw-bold text-uppercase text-muted small mb-3">Shipping Details</h6>
                                            <p class="mb-1 fw-bold"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Address</p>
                                            <p class="text-muted small ms-4 mb-3">
                                                <%= order.shipping_address %><br>
                                                <%= order.shipping_city %>, <%= order.shipping_state %> <%= order.shipping_zip %>
                                            </p>
                                            
                                            <p class="mb-1 fw-bold"><i class="bi bi-telephone-fill text-primary me-2"></i>Contact</p>
                                            <p class="text-muted small ms-4 mb-4"><%= order.phone_number %></p>
                                            
                                            <% const canCancel = (order.status === 'Pending' || order.status === 'Processing'); %>
                                            <% if (canCancel) { %>
                                            <button class="btn btn-outline-danger w-100 mt-2 fw-semibold" onclick="cancelOrder(<%= order.order_id %>)">
                                                <i class="bi bi-x-circle me-2"></i> Cancel Order
                                            </button>
                                            <% } %>

                                            <% const canReturn = (order.status === 'Delivered'); %>
                                            <button class="btn btn-outline-primary w-100 mt-2 fw-semibold" onclick="showReturnModal(<%= order.order_id %>)" <%= canReturn ? '' : 'disabled' %>>
                                                <i class="bi bi-arrow-return-left me-2"></i> Return Order
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Full Width Review Section -->
                                <% if (order.status === 'Delivered' && order.items && order.items.length > 0) { %>
                                    <% const unreviewedItem = order.items.find(i => !i.review_rating); %>
                                    <% if (unreviewedItem) { %>
                                        <div class="mt-4">
                                            <button class="btn btn-dark w-100 py-3 rounded-4 fw-bold fs-5 shadow-sm review-btn-hover" 
                                                    onclick='showReviewModal({ order_id: <%= order.order_id %>, art_id: <%= unreviewedItem.art_id %>, title: "<%= unreviewedItem.title.replace(/"/g, "&quot;") %>", image_path: "<%= unreviewedItem.image_path || "" %>" })'>
                                                <i class="bi bi-star-fill text-warning me-2"></i> Leave a Review
                                            </button>
                                        </div>
                                    <% } else { %>
                                        <div class="mt-4 p-4 rounded-4" style="background-color: #fdfdfd; border: 1px solid #e2e8f0;">
                                            <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-chat-quote-fill text-primary me-2"></i>Your Reviews</h6>
                                            <% order.items.forEach(item => { %>
                                                <% if (item.review_rating) { %>
                                                    <div class="mb-3 pb-3 <%= order.items.length > 1 ? 'border-bottom' : '' %>">
                                                        <div class="d-flex justify-content-between mb-2">
                                                            <div class="fw-bold text-dark"><%= item.title %></div>
                                                            <div class="text-warning">
                                                                <% for(let i=1; i<=5; i++) { %>
                                                                    <i class="bi bi-star-fill <%= i <= item.review_rating ? '' : 'text-muted opacity-25' %>"></i>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                        <% if (item.review_comment) { %>
                                                            <p class="text-muted small mb-0 fst-italic">"<%= item.review_comment %>"</p>
                                                        <% } %>
                                                    </div>
                                                <% } %>
                                            <% }) %>
                                        </div>
                                    <% } %>
                                <% } %>
                                
                            </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-box2 text-muted" style="font-size: 5rem;"></i>
                        <h3 class="mt-4 text-secondary">You haven't placed any orders yet</h3>
                        <p class="text-muted mb-4">Discover beautiful artworks and create your first masterpiece order today.</p>
                        <a href="/user/home" class="btn art-btn px-4 py-2 fs-5">Browse Artworks</a>
                    </div>
                <% } %>
                
                <!-- Custom Art Requests Block (Hidden by default) -->
                <% if (typeof customRequests !== 'undefined' && customRequests && customRequests.length > 0) { %>
                    <% customRequests.forEach(req => { %>
                        <% 
                            const reqDate = new Date(req.created_at);
                            let borderClass = '';
                            if (req.status === 'Cancelled') borderClass = 'border-start border-5 border-danger';
                            else if (req.status === 'Delivered') borderClass = 'border-start border-5 border-success';
                            else borderClass = 'border-start border-5 border-primary'; 
                        %>
                        <div class="order-card <%= borderClass %> custom-req-card" data-status="custom" data-req-status="<%= req.status %>" style="display: none;">
                            <div class="order-header d-flex flex-wrap justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark d-flex align-items-center">
                                        Custom Request #REQ-<%= req.request_id %>
                                        <% if (req.reference_image) { %>
                                            <i class="bi bi-image ms-2 fs-6 text-muted" title="Reference Image Attached"></i>
                                        <% } %>
                                    </h5>
                                    <small class="text-muted">Requested on <%= reqDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></small>
                                </div>
                                <div class="text-end mt-2 mt-sm-0">
                                    <h4 class="text-dark fw-bold mb-0">₹<%= req.estimated_price %></h4>
                                    <span class="badge <%= req.status === 'Cancelled' ? 'bg-danger' : (req.status === 'Delivered' ? 'bg-success' : 'bg-primary') %> px-3 py-2 mt-1 shadow-sm">
                                        <%= req.status.toUpperCase() %>
                                    </span>
                                </div>
                            </div>
                            <div class="card-body p-4 p-md-5">
                                <div class="row">
                                    <div class="col-md-6 mb-4 mb-md-0">
                                        <h6 class="fw-bold text-muted mb-3">REQUEST DETAILS</h6>
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-2"><i class="bi bi-arrows-fullscreen text-secondary me-2"></i> <strong>Size:</strong> <%= req.size %></li>
                                            <li class="mb-2"><i class="bi bi-palette text-secondary me-2"></i> <strong>Format:</strong> <%= req.format %></li>
                                            <li><i class="bi bi-person text-secondary me-2"></i> <strong>Subjects:</strong> <%= req.qty %></li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="fw-bold text-muted mb-3">INSTRUCTIONS</h6>
                                        <p class="text-secondary bg-light p-3 rounded" style="font-family: 'Caveat', cursive; font-size: 1.3rem;"><%= req.description || 'No special instructions provided.' %></p>
                                    </div>
                                </div>

                                <!-- Review Section for Delivered Custom Art -->
                                <% if (req.status === 'Delivered') { %>
                                    <% if (req.customer_review) { %>
                                        <div class="mt-4 p-4 rounded-4" style="background-color: #fdfdfd; border: 1px solid #e2e8f0;">
                                            <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-chat-quote-fill text-primary me-2"></i>Your Review</h6>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="fw-bold text-dark">Custom Artwork #REQ-<%= req.request_id %></div>
                                                <div class="text-warning fs-5">
                                                    <% for(let i=1; i<=5; i++) { %>
                                                        <i class="bi bi-star-fill <%= i <= (req.rating || 5) ? '' : 'text-muted opacity-25' %>"></i>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <p class="text-muted small mb-0 fst-italic">"<%= req.customer_review %>"</p>
                                        </div>
                                    <% } else { %>
                                        <div class="mt-4">
                                            <button class="btn btn-dark w-100 py-3 rounded-4 fw-bold fs-5 shadow-sm review-btn-hover" 
                                                    onclick='showReviewModal({ custom_request_id: <%= req.request_id %>, title: "Custom Art #REQ-<%= req.request_id %>", image_path: "<%= req.reference_image || "" %>" })'>
                                                <i class="bi bi-star-fill text-warning me-2"></i> Leave a Review
                                            </button>
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </section>

    </div>

<!-- Return Order Modal -->
<div class="modal fade" id="returnOrderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <div class="modal-header border-bottom-0 bg-light rounded-top-4">
                <h5 class="modal-title fw-bold">Return Order <span id="returnOrderIdDisplay" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="returnOrderForm" onsubmit="submitReturn(event)">
                    <input type="hidden" id="returnOrderId" name="order_id">
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small text-uppercase">Reason for Return</label>
                        <select class="form-select form-select-lg" id="returnReason" name="reason" onchange="toggleOtherReason()" required>
                            <option value="" disabled selected>Select a reason...</option>
                            <option value="Different Art">Different Art</option>
                            <option value="Defective product">Defective product</option>
                            <option value="Not Like">Not Like</option>
                            <option value="Other">Other Reason</option>
                        </select>
                    </div>
                    
                    <div class="mb-4 d-none" id="otherReasonContainer">
                        <label class="form-label fw-bold text-muted small text-uppercase">Please specify</label>
                        <textarea class="form-control" id="otherReason" name="other_reason" rows="3" placeholder="Describe the issue..."></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold" id="submitReturnBtn">Submit Return Request</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<%- include('partials/footer') %>
    <script>
        function cancelOrder(orderId) {
            if (confirm("Are you sure you want to cancel this order? This action cannot be undone.")) {
                fetch(`/api/user/orders/${orderId}/cancel`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        window.location.reload(); // Reload to show updated status
                    } else {
                        alert(data.message || 'Failed to cancel order.');
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('An error occurred. Please try again later.');
                });
            }
        }

        let currentTab = 'order'; // 'order' or 'custom'
        let currentFilter = 'All';

        const filterOptions = {
            order: ['All', 'Pending', 'Processing', 'Shipped', 'Delivered', 'Cancelled'],
            custom: ['All', 'Pending', 'Processing', 'Shipped', 'Delivered', 'Cancelled']
        };

        function switchTab(tab, element) {
            currentTab = tab;
            currentFilter = 'All';
            
            document.querySelectorAll('.order-tabs .nav-link').forEach(link => link.classList.remove('active'));
            if(element) element.classList.add('active');
            
            document.getElementById('currentFilterText').innerText = 'All';
            
            const menu = document.getElementById('filterDropdownMenu');
            menu.innerHTML = '';
            
            filterOptions[tab].forEach(opt => {
                menu.innerHTML += `<li><a class="dropdown-item py-2" href="#" onclick="applyFilter('${opt}'); return false;">${opt}</a></li>`;
            });

            renderCards();
        }

        function applyFilter(filter) {
            currentFilter = filter;
            document.getElementById('currentFilterText').innerText = filter;
            renderCards();
        }

        function renderCards() {
            const cards = document.querySelectorAll('.order-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const isCustom = card.classList.contains('custom-req-card');
                let shouldShow = false;
                
                if (currentTab === 'custom' && isCustom) {
                    const reqStatus = card.getAttribute('data-req-status');
                    if (currentFilter === 'All' || reqStatus === currentFilter) {
                        shouldShow = true;
                    }
                } else if (currentTab === 'order' && !isCustom) {
                    const orderStatus = card.getAttribute('data-status');
                    if (currentFilter === 'All' || orderStatus === currentFilter) {
                        shouldShow = true;
                    }
                }

                if (shouldShow) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Handle Empty State
            let emptyState = document.getElementById('empty-filter-state');
            const noRegularOrders = document.getElementById('no-regular-orders');
            if (noRegularOrders) noRegularOrders.style.display = 'none';
            
            if (visibleCount === 0) {
                if (!emptyState) {
                    emptyState = document.createElement('div');
                    emptyState.id = 'empty-filter-state';
                    emptyState.className = 'text-center py-5';
                    document.getElementById('orders-container').appendChild(emptyState);
                }
                emptyState.innerHTML = `
                    <i class="bi ${currentTab === 'custom' ? 'bi-brush' : 'bi-search'} text-muted" style="font-size: 4rem;"></i>
                    <h4 class="mt-4 text-secondary">No ${currentTab === 'custom' ? 'requests' : 'orders'} found</h4>
                    <p class="text-muted">You have no ${currentTab === 'custom' ? 'custom requests' : 'orders'} matching this filter.</p>
                `;
                emptyState.style.display = 'block';
            } else if (emptyState) {
                emptyState.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const orderTab = document.getElementById('order-tab');
            if(orderTab) {
                switchTab('order', orderTab);
            }
        });

    // --- Return Order Flow ---
    let returnModal;
    
    document.addEventListener('DOMContentLoaded', () => {
        returnModal = new bootstrap.Modal(document.getElementById('returnOrderModal'));
    });

    function showReturnModal(orderId) {
        document.getElementById('returnOrderId').value = orderId;
        document.getElementById('returnOrderIdDisplay').innerText = `#ORD-${orderId}`;
        
        // Reset form
        document.getElementById('returnOrderForm').reset();
        document.getElementById('otherReasonContainer').classList.add('d-none');
        document.getElementById('otherReason').required = false;
        
        returnModal.show();
    }

    function toggleOtherReason() {
        const reason = document.getElementById('returnReason').value;
        const container = document.getElementById('otherReasonContainer');
        const input = document.getElementById('otherReason');
        
        if (reason === 'Other') {
            container.classList.remove('d-none');
            input.required = true;
        } else {
            container.classList.add('d-none');
            input.required = false;
        }
    }

    async function submitReturn(e) {
        e.preventDefault();
        
        const btn = document.getElementById('submitReturnBtn');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
        btn.disabled = true;

        const orderId = document.getElementById('returnOrderId').value;
        const reason = document.getElementById('returnReason').value;
        const otherReason = document.getElementById('otherReason').value;

        try {
            const response = await fetch('/api/orders/return', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_id: orderId, reason, other_reason: otherReason })
            });

            const data = await response.json();

            if (data.success) {
                returnModal.hide();
                Swal.fire({
                    title: 'Return Requested!',
                    html: `Your return has been requested successfully.<br><br><strong>Estimated Pickup:</strong> ${data.estimated_pickup}`,
                    icon: 'success',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#212529'
                }).then(() => {
                    location.reload();
                });
            } else {
                throw new Error(data.message || 'Failed to request return');
            }
        } catch (error) {
            Swal.fire({
                title: 'Error',
                text: error.message,
                icon: 'error',
                confirmButtonColor: '#212529'
            });
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }

</script>
</body>
</html>

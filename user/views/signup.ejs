<!DOCTYPE html>
<html>
<head>
<title>Signup</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<!-- 🔥 Better Font -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
body {
    margin:0;
    height:100vh;
    font-family: 'Inter', sans-serif;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
}

/* Background Blur */
body::before {
    content:"";
    position:absolute;
    width:100%;
    height:100%;
    background: url('/images/auth.png') center/cover no-repeat;
    filter: blur(2px);
    transform: scale(1.05);
    z-index:-2;
}

body::after {
    content:"";
    position:absolute;
    width:100%;
    height:100%;
    background: rgba(0,0,0,0.5);
    z-index:-1;
}

/* Card */
.form-box {
    width:480px;
    padding:50px;
    border-radius:12px;
    background: rgba(0,0,0,0.75);
    border:1px solid rgba(255,255,255,0.1);
    box-shadow: 0 15px 50px rgba(0,0,0,0.6);
    color:#fff;

    /* subtle animation */
    animation: fadeIn 0.6s ease;
}

@keyframes fadeIn {
    from { opacity:0; transform: translateY(20px); }
    to { opacity:1; transform: translateY(0); }
}

/* Title */
.form-box h3 {
    text-align:center;
    margin-bottom:30px;
    font-weight:600;
    font-size:24px;
}

/* Inputs */
.form-control {
    background: rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.15);
    color:#fff;
    height:56px;
    font-size:15px;
    border-radius:8px;
    margin-bottom:24px;
}

.form-control::placeholder {
    color:#fff;
}

.form-control:focus {
    background: rgba(255,255,255,0.08);
    border-color:#fff;
    box-shadow:none;
    color: white;
}

/* Button */
.btn-custom {
    height:56px;
    border-radius:8px;
    font-size:16px;
    font-weight:600;
    background: linear-gradient(to right, #111, #333);
    border:none;
    transition:0.3s;
    color: white;
}

.btn-custom:hover {
    background:#000;
}

/* Footer */
.extra-text {
    text-align:center;
    font-size:13px;
    margin-top:18px;
    color:#fff;
}

.extra-text a {
    color:#fff;
    text-decoration:none;
}

.extra-text a:hover {
    text-decoration:underline;
}

/* Alerts */
.alert {
    padding:8px;
    font-size:13px;
}
</style>
</head>

<body>

<div class="form-box">

<h3>Sign Up</h3>

<% if (typeof error !== 'undefined') { %>
<div class="alert alert-danger d-flex align-items-center py-2 px-3 rounded-3 shadow-sm border-0 bg-danger bg-opacity-25 text-white">
    <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
    <div><strong>Error:</strong> <%= error %></div>
</div>
<% } %>

<% if (typeof success !== 'undefined') { %>
<div class="alert alert-success d-flex align-items-center py-2 px-3 rounded-3 shadow-sm border-0 bg-success bg-opacity-25 text-white">
    <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
    <div><strong>Success:</strong> <%= success %></div>
</div>

    <script>
    setTimeout(()=>{
        window.location.href="/user";
    },1000);
    </script>
<% } %>


<div id="message"></div>

<!-- <form method="POST" action="/signup"> -->

<form id="signupForm">
<input name="name" class="form-control" placeholder="Full Name">
<input name="email" class="form-control" placeholder="Email Address">
<input name="password" type="password" class="form-control" placeholder="Password">

<button class="btn btn-custom w-100 mt-2">Create Account</button>

</form>

<div class="extra-text">
Already have an account? <a href="/user/signin">Login</a>
</div>

</div>

<!-- JQuery  -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


<script>
    $('#signupForm').submit(function(e){
        e.preventDefault();

        const formData = {
            name : $('input[name="name"]').val(),
            email : $('input[name="email"]').val(),
            password : $('input[name="password"]').val()
        }

        $.ajax({
            url : '/user/signup',
            type : 'POST',
            data : formData,

            success : function(response){
                if(response.status == 'error')
                {
                    $("#message").html(`
                        <div class="alert alert-danger d-flex align-items-center py-2 px-3 rounded-3 shadow-sm border-0 bg-danger bg-opacity-25 text-white">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                            <div><strong>Error:</strong> ${response.message}</div>
                        </div>
                    `)
                }

                if(response.status == 'success')
                {
                    $("#message").html(`
                        <div class="alert alert-success d-flex align-items-center py-2 px-3 rounded-3 shadow-sm border-0 bg-success bg-opacity-25 text-white">
                            <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                            <div><strong>Success:</strong> ${response.message}</div>
                        </div>
                    `)

                    setTimeout(()=>{
                        window.location.href = '/user/signin'
                    },800)
                }
            }
        })
    })
</script>
</body>
</html>
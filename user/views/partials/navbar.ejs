<style>
.navbar-nav .nav-link {
    color: #ffffff !important;
    opacity: 0.9;
    transition: all 0.3s ease;
    border-bottom: 2px solid transparent;
    padding-bottom: 5px;
}
.navbar-nav .nav-link:hover {
    color: #ffffff !important;
    opacity: 1;
}
.navbar-nav .nav-link.active {
    color: #ffffff !important;
    opacity: 1;
    font-weight: 600;
    border-bottom-color: #fff;
}
/* Happy Customers link default dark yellow and no white on hover */
.navbar-nav .nav-link.nav-happy-customer {
    color: #F39C12 !important;
    opacity: 1 !important;
    font-weight: 600;
}
.navbar-nav .nav-link.nav-happy-customer:hover {
    color: #E67E22 !important;
    opacity: 1 !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Navbar active state logic
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
    navLinks.forEach(link => {
        link.classList.remove('active');
        const href = link.getAttribute('href');
        if (currentPath === href || (currentPath.startsWith('/user/art') && href === '/user/artists' && !currentPath.includes('custom-art'))) {
            link.classList.add('active');
        }
    });
});
</script>

<script>
async function updateCartCount() {
    try {
        const response = await fetch('/api/cart/count');
        const data = await response.json();
        const badge = document.getElementById('cart-count-badge');
        if (data.success && data.count > 0) {
            badge.innerText = data.count;
            badge.style.display = 'inline-block';
        } else {
            badge.style.display = 'none';
        }
    } catch (e) {
        console.error('Error fetching cart count', e);
    }
}
document.addEventListener('DOMContentLoaded', updateCartCount);
</script>

<!-- Dynamic Favicon Generator -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const setFavicon = () => {
            const canvas = document.createElement('canvas');
            canvas.width = 64;
            canvas.height = 64;
            const ctx = canvas.getContext('2d');
            
            ctx.fillStyle = '#212529';
            ctx.beginPath();
            ctx.arc(32, 32, 32, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 38px Caveat, cursive';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('F', 22, 34);
            
            ctx.fillStyle = '#28a745';
            ctx.font = '18px sans-serif';
            ctx.fillText('☘︎', 44, 28);
            
            ctx.fillStyle = '#ffc107';
            ctx.font = '16px sans-serif';
            ctx.fillText('˖', 52, 42);

            const link = document.createElement('link');
            link.rel = 'icon';
            link.type = 'image/png';
            link.href = canvas.toDataURL('image/png');
            
            const existing = document.querySelector('link[rel="icon"]');
            if (existing) existing.remove();
            
            document.head.appendChild(link);
        };
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(setFavicon);
        } else {
            setTimeout(setFavicon, 500);
        }
    });
</script>
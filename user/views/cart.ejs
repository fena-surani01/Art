<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fenaria - Your Basket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <%- include('partials/navbar') %>

    <!-- Cart Content -->
    <section class="container py-5">
        <div class="text-center mb-5">
            <h2 class="section-title">
                Your <span class="section-highlight">Basket</span>
            </h2>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <% let hasOutOfStock = false; %>
                <% if (cartItems.length > 0) { %>
                    <% cartItems.forEach(item => { %>
                        <% if (item.stock <= 0) hasOutOfStock = true; %>
                        <div class="card mb-3 shadow-sm border-0 <%= item.stock <= 0 ? 'opacity-75 bg-light' : '' %>" id="cart-item-<%= item.cart_id %>" style="<%= item.stock <= 0 ? 'filter: grayscale(0.5);' : '' %>">
                            <div class="row g-0">
                                <div class="col-md-4" style="height: 200px;">
                                    <a href="/user/art/<%= item.art_id %>">
                                        <img src="<%= item.image_path ? item.image_path : '/images/default-art.jpg' %>" class="img-fluid rounded-start w-100 h-100" style="object-fit: cover;" alt="<%= item.title %>">
                                    </a>
                                </div>
                                <div class="col-md-8">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h5 class="card-title art-title fs-3 mb-0">
                                                <a href="/user/art/<%= item.art_id %>" class="text-decoration-none text-dark"><%= item.title %></a>
                                            </h5>
                                            <button class="btn text-danger p-0" onclick="removeFromCart(<%= item.cart_id %>, <%= item.price %>, <%= item.quantity %>)" title="Remove item"><i class="bi bi-trash fs-4"></i></button>
                                        </div>
                                        <p class="card-text text-muted mb-1"><small>By <%= item.artist_name %></small></p>
                                        <p class="card-text mb-1">
                                            <span class="badge bg-secondary"><%= item.category %></span>
                                            <% if (item.art_type) { %><span class="badge bg-info text-dark"><%= item.art_type %></span><% } %>
                                            <% if (item.art_size) { %><span class="badge bg-light text-dark border"><%= item.art_size %></span><% } %>
                                        </p>
                                        
                                        <% if (item.stock <= 0) { %>
                                            <div class="mt-3">
                                                <span class="badge bg-danger p-2 fs-6 rounded-pill"><i class="bi bi-exclamation-circle me-1"></i> Out of Stock</span>
                                                <p class="text-danger small mt-1 mb-0">Please remove this item to proceed.</p>
                                            </div>
                                        <% } else { %>
                                            <div class="d-flex justify-content-between align-items-center mt-3">
                                                <div class="input-group" style="width: 120px;">
                                                    <button class="btn btn-outline-secondary btn-sm" type="button" id="minus-btn-<%= item.cart_id %>" onclick="updateQty(<%= item.cart_id %>, <%= item.quantity - 1 %>, <%= item.stock %>, <%= item.price %>)" <%= item.quantity <= 1 ? 'disabled' : '' %>>-</button>
                                                    <input type="text" id="qty-input-<%= item.cart_id %>" class="form-control text-center form-control-sm" value="<%= item.quantity %>" readonly>
                                                    <button class="btn btn-outline-secondary btn-sm" type="button" id="plus-btn-<%= item.cart_id %>" onclick="updateQty(<%= item.cart_id %>, <%= item.quantity + 1 %>, <%= item.stock %>, <%= item.price %>)">+</button>
                                                </div>
                                                <p class="card-text fw-bold fs-4 art-price mb-0">₹<span id="price-<%= item.cart_id %>"><%= (item.price * item.quantity).toFixed(2) %></span></p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
                        <h4 class="mt-3">Your basket is empty!</h4>
                        <a href="/user/home" class="btn art-btn mt-3">Continue Shopping</a>
                    </div>
                <% } %>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0" style="background-color: #f8f9fa;">
                    <div class="card-body p-4">
                        <h5 class="card-title mb-4 fs-4 border-bottom pb-2">Order Summary</h5>
                        <div class="d-flex justify-content-between mb-3 fs-5">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-semibold">₹<span id="cart-subtotal"><%= subTotal %></span></span>
                        </div>
                        <div class="d-flex justify-content-between mb-1 fs-5">
                            <span class="text-muted">Shipping</span>
                            <span class="fw-semibold" id="cart-shipping-container">
                                <% if (shipping > 0) { %>
                                    ₹<span id="cart-shipping"><%= shipping %></span>
                                <% } else { %>
                                    <span class="text-success" id="cart-shipping-free">Free</span>
                                <% } %>
                            </span>
                        </div>
                        <div class="text-muted mb-3" style="font-size: 0.8rem;">
                            <i class="bi bi-info-circle"></i> Free shipping on orders over ₹1000
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold fs-4">Total</span>
                            <span class="fw-bold fs-3 text-primary">₹<span id="cart-final-total"><%= finalTotal %></span></span>
                        </div>
                        <a href="/user/checkout" class="btn art-btn w-100 fs-5 py-2 <%= (cartItems.length === 0 || hasOutOfStock) ? 'disabled' : '' %>" id="checkout-btn">
                            <%= hasOutOfStock ? 'Remove out of stock items' : 'Proceed to Checkout' %>
                        </a>
                        
                        <% if (cartItems.length > 0) { %>
                        <div class="mt-4 pt-4 border-top" id="delivery-section">
                            <h6 class="mb-4">Estimated Delivery</h6>
                            <div class="position-relative mx-3">
                                <div class="progress" style="height: 3px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: 50%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <button type="button" class="position-absolute top-0 start-0 translate-middle btn btn-sm btn-success rounded-pill d-flex align-items-center justify-content-center" style="width: 2rem; height:2rem;"><i class="bi bi-box-seam"></i></button>
                                <button type="button" class="position-absolute top-0 start-50 translate-middle btn btn-sm btn-success rounded-pill d-flex align-items-center justify-content-center" style="width: 2rem; height:2rem;"><i class="bi bi-truck"></i></button>
                                <button type="button" class="position-absolute top-0 start-100 translate-middle btn btn-sm btn-secondary rounded-pill d-flex align-items-center justify-content-center" style="width: 2rem; height:2rem;"><i class="bi bi-house-door"></i></button>
                            </div>
                            <div class="d-flex justify-content-between text-muted mt-3" style="font-size: 0.85rem;">
                                <div class="text-center" style="margin-left: -10px;">Packed</div>
                                <div class="text-center">Shipped</div>
                                <div class="text-center fw-bold text-dark" id="delivery-date" style="margin-right: -10px;"></div>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;">
        <div id="cartToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header text-white" id="toastHeader">
                <i class="bi bi-bell-fill me-2"></i>
                <strong class="me-auto" id="toastTitle">Notification</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toastBody">
                <!-- Message -->
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('partials/footer') %>


<script src="/js/cart.js"></script>
</body>
</html>

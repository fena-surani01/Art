<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fenaria - Checkout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .step-indicator { display: flex; justify-content: center; margin-bottom: 2rem; }
        .step { text-align: center; flex: 1; position: relative; }
        .step:not(:last-child)::after {
            content: ''; position: absolute; top: 15px; left: 50%; right: -50%;
            height: 2px; background: #e9ecef; z-index: -1;
        }
        .step-circle {
            width: 35px; height: 35px; border-radius: 50%; background: #e9ecef;
            color: #6c757d; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 10px; font-weight: bold; border: 2px solid #fff;
        }
        .step.active .step-circle { background: #2C3E50; color: #fff; }
        .step.active ~ .step .step-circle { background: #e9ecef; }
        .step.active::after { background: #2C3E50; }
        
        .checkout-section { display: none; }
        .checkout-section.active { display: block; animation: fadeIn 0.4s; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body style="background-color: #f8f9fa;">
    <%- include('partials/navbar') %>

    <section class="container py-5">
        <div class="text-center mb-5">
            <h2 class="section-title">Secure <span class="section-highlight">Checkout</span></h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Stepper -->
                <div class="step-indicator">
                    <div class="step active" id="step1-indicator">
                        <div class="step-circle">1</div>
                        <div class="fw-semibold">Shipping Details</div>
                    </div>
                    <div class="step" id="step2-indicator">
                        <div class="step-circle">2</div>
                        <div class="fw-semibold">Review Order</div>
                    </div>
                    <div class="step" id="step3-indicator">
                        <div class="step-circle">3</div>
                        <div class="fw-semibold">Payment</div>
                    </div>
                </div>

                <div class="card shadow-sm border-0" style="border-radius: 15px;">
                    <div class="card-body p-4 p-md-5">
                        <form id="checkoutForm" novalidate>
                            <!-- STEP 1: Details -->
                            <div class="checkout-section active" id="step1">
                                <h4 class="mb-4 fw-bold">Shipping Information</h4>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small fw-bold">Full Name (Required)</label>
                                        <input type="text" class="form-control" name="name" id="name" value="<%= user.name %>" required style="background: #f8f9fa;">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small fw-bold">Phone Number (Required)</label>
                                        <input type="text" class="form-control" name="phone_number" id="phone_number" value="<%= user.phone_number || '' %>" required placeholder="Enter your phone number">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label text-muted small fw-bold">Address (Required)</label>
                                        <input type="text" class="form-control" name="address" id="address" value="<%= user.address || '' %>" required placeholder="123 Art Street, Apt 4B">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small fw-bold">State (Required)</label>
                                        <select class="form-select" name="state" id="state" required>
                                            <option value="" disabled selected>Select a State...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label text-muted small fw-bold">City (Required)</label>
                                        <select class="form-select" name="city" id="city" required disabled>
                                            <option value="" disabled selected>Select a City...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small fw-bold">ZIP Code (Required)</label>
                                        <input type="text" class="form-control" name="zip_code" id="zip_code" value="<%= user.zip_code || '' %>" required placeholder="400001">
                                    </div>
                                </div>
                                <div class="text-end mt-4">
                                    <button type="button" class="btn art-btn px-4" onclick="nextStep(2)">Continue to Review <i class="bi bi-arrow-right ms-2"></i></button>
                                </div>
                            </div>

                            <!-- STEP 2: Review -->
                            <div class="checkout-section" id="step2">
                                <h4 class="mb-4 fw-bold">Review Your Order</h4>
                                <div class="table-responsive mb-4">
                                    <table class="table align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Artwork</th>
                                                <th class="text-center">Qty</th>
                                                <th class="text-end">Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% cartItems.forEach(item => { %>
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <img src="<%= item.image_path || '/images/default-art.jpg' %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" class="me-3">
                                                            <div>
                                                                <h6 class="mb-0 fw-bold"><%= item.title %></h6>
                                                                <small class="text-muted"><%= item.artist_name %></small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center"><%= item.quantity %></td>
                                                    <td class="text-end fw-semibold">₹<%= (item.price * item.quantity).toFixed(2) %></td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                
                                <div class="row justify-content-end">
                                    <div class="col-md-6 col-lg-5">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Subtotal:</span>
                                            <span class="fw-semibold">₹<%= subTotal %></span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 border-bottom pb-2">
                                            <span class="text-muted">Shipping:</span>
                                            <span class="fw-semibold"><%= shipping > 0 ? '₹' + shipping : 'Free' %></span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-3">
                                            <span class="fw-bold fs-5">Total:</span>
                                            <span class="fw-bold fs-4 text-primary">₹<%= finalTotal %></span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="d-flex justify-content-between mt-4">
                                    <button type="button" class="btn btn-light px-4" onclick="nextStep(1)"><i class="bi bi-arrow-left me-2"></i> Back</button>
                                    <button type="button" class="btn art-btn px-4" onclick="nextStep(3)">Continue to Payment <i class="bi bi-arrow-right ms-2"></i></button>
                                </div>
                            </div>

                            <!-- STEP 3: Payment -->
                            <div class="checkout-section" id="step3">
                                <h4 class="mb-4 fw-bold">Select Payment Method</h4>
                                
                                <div class="card mb-3 border border-2 border-primary" style="background-color: #f8fbff; cursor: pointer;">
                                    <div class="card-body">
                                        <div class="form-check d-flex align-items-center">
                                            <input class="form-check-input me-3" type="radio" name="payment_method" id="payCOD" value="COD" checked style="transform: scale(1.5);">
                                            <label class="form-check-label w-100" for="payCOD">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="mb-0 fw-bold">Cash on Delivery (COD)</h6>
                                                        <small class="text-muted">Pay with cash when your artwork arrives.</small>
                                                    </div>
                                                    <i class="bi bi-cash-coin fs-2 text-primary"></i>
                                                </div>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-4" style="cursor: not-allowed; opacity: 0.6;">
                                    <div class="card-body">
                                        <div class="form-check d-flex align-items-center">
                                            <input class="form-check-input me-3" type="radio" name="payment_method" id="payOnline" value="Online" disabled style="transform: scale(1.5);">
                                            <label class="form-check-label w-100" for="payOnline">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <h6 class="mb-0 fw-bold">Online Payment</h6>
                                                        <small class="text-muted">Coming soon! Credit/Debit cards & UPI.</small>
                                                    </div>
                                                    <i class="bi bi-credit-card fs-2 text-muted"></i>
                                                </div>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-4 border-top pt-4">
                                    <button type="button" class="btn btn-light px-4" onclick="nextStep(2)"><i class="bi bi-arrow-left me-2"></i> Back</button>
                                    <button type="submit" class="btn btn-success px-5 fs-5 shadow-sm" id="placeOrderBtn">
                                        <i class="bi bi-check-circle me-2"></i> Place Order (₹<%= finalTotal %>)
                                    </button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;">
        <div id="systemToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header text-white" id="toastHeader">
                <i class="bi bi-bell-fill me-2"></i>
                <strong class="me-auto" id="toastTitle">Notification</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toastBody"></div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script>
        function showToast(message, type) {
            const toastEl = document.getElementById('systemToast');
            const toastHeader = document.getElementById('toastHeader');
            const toastBody = document.getElementById('toastBody');
            const toastTitle = document.getElementById('toastTitle');

            toastHeader.className = `toast-header text-white bg-${type}`;
            toastTitle.innerText = type === 'success' ? 'Success' : 'Error';
            toastBody.innerText = message;

            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        function nextStep(step) {
            // Manual Form Validation check before leaving step 1
            if (step === 2) {
                const name = document.getElementById('name').value.trim();
                const phone = document.getElementById('phone_number').value.trim();
                const address = document.getElementById('address').value.trim();
                const city = document.getElementById('city').value.trim();
                const state = document.getElementById('state').value.trim();
                const zip = document.getElementById('zip_code').value.trim();

                if (!name) return showToast('Please enter your Full Name.', 'danger');
                if (!phone) return showToast('Please enter your Phone Number.', 'danger');
                if (!address) return showToast('Please enter your Address.', 'danger');
                if (!city) return showToast('Please enter your City.', 'danger');
                if (!state) return showToast('Please enter your State.', 'danger');
                if (!zip) return showToast('Please enter your ZIP Code.', 'danger');
            }
        
            document.querySelectorAll('.checkout-section').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.step').forEach(el => el.classList.remove('active'));
            
            document.getElementById(`step${step}`).classList.add('active');
            
            for(let i=1; i<=step; i++) {
                document.getElementById(`step${i}-indicator`).classList.add('active');
            }
        }

        // Location Dropdown Logic
        let citiesData = [];
        
        window.addEventListener('DOMContentLoaded', () => {
            fetch('/api/locations')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const stateSelect = document.getElementById('state');
                    citiesData = data.cities;
                    
                    data.states.forEach(state => {
                        const option = document.createElement('option');
                        option.value = state.state_name;
                        option.textContent = state.state_name;
                        option.dataset.id = state.id;
                        stateSelect.appendChild(option);
                    });
                    
                    // Pre-select if user data exists
                    const userState = "<%= user.state || '' %>";
                    const userCity = "<%= user.city || '' %>";
                    
                    if (userState) {
                        stateSelect.value = userState;
                        const stateId = stateSelect.options[stateSelect.selectedIndex]?.dataset.id;
                        if (stateId) {
                            populateCities(stateId, userCity);
                        }
                    }
                }
            })
            .catch(console.error);
        });
        
        document.getElementById('state').addEventListener('change', function() {
            const stateId = this.options[this.selectedIndex].dataset.id;
            populateCities(stateId);
        });
        
        function populateCities(stateId, preselectCity = '') {
            const citySelect = document.getElementById('city');
            citySelect.innerHTML = '<option value="" disabled selected>Select a City...</option>';
            citySelect.disabled = false;
            
            const filteredCities = citiesData.filter(c => c.state_id == stateId);
            filteredCities.forEach(city => {
                const option = document.createElement('option');
                option.value = city.city_name;
                option.textContent = city.city_name;
                citySelect.appendChild(option);
            });
            
            if (preselectCity) {
                citySelect.value = preselectCity;
            }
        }

        document.getElementById('checkoutForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('placeOrderBtn');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';
            btn.disabled = true;

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            fetch('/api/checkout/process', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                if(res.success) {
                    window.location.href = '/user/checkout/success';
                } else {
                    alert('Error: ' + res.message);
                    btn.innerHTML = '<i class="bi bi-check-circle me-2"></i> Place Order';
                    btn.disabled = false;
                }
            })
            .catch(err => {
                console.error(err);
                alert('Something went wrong!');
                btn.innerHTML = '<i class="bi bi-check-circle me-2"></i> Place Order';
                btn.disabled = false;
            });
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fenaria - Happy Customers</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        .gallery-container {
            padding: 50px 0 90px;
            background: #ffffff;
        }

        .happy-art-card {
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: none !important;
            border-top: 4px solid #000000 !important;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .happy-art-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }

        .art-image-wrapper {
            position: relative;
            width: 100%;
            padding-top: 100%; /* 1:1 Aspect Ratio */
            overflow: hidden;
            background-color: #f8f9fa;
            cursor: pointer;
        }

        .art-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .happy-art-card:hover .art-image {
            transform: scale(1.06);
        }

        .art-badge-overlay {
            position: absolute;
            top: 15px;
            right: 15px;
            display: flex;
            gap: 6px;
            z-index: 5;
        }

        .art-card-body {
            padding: 24px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .customer-name-heading {
            font-size: 1.25rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 4px;
            text-transform: capitalize;
        }

        .star-rating i {
            font-size: 1.1rem;
        }

        /* Prevent black dark backdrop stacking when multiple modals open */
        .modal-backdrop {
            background-color: rgba(15, 23, 42, 0.35) !important;
            opacity: 1 !important;
            backdrop-filter: blur(4px);
        }

        .modal-backdrop + .modal-backdrop {
            display: none !important;
        }

        .modal-body::-webkit-scrollbar {
            width: 6px;
        }
        .modal-body::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .modal-body::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        .empty-state {
            text-align: center;
            padding: 90px 20px;
        }

        .empty-icon {
            font-size: 5rem;
            color: #dee2e6;
            margin-bottom: 20px;
        }

        .card-carousel-control {
            width: 32px;
            height: 32px;
            background: rgba(0,0,0,0.5);
            border-radius: 50%;
            top: 50%;
            transform: translateY(-50%);
            z-index: 6;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <% 
    // Title case helper
    function toTitleCase(str) {
        if (!str) return 'Not Assigned';
        return str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
    }
    %>

    <!-- Hero Section matching Custom Art page -->
    <section class="hero-section text-center">
        <div class="container">
            <h1 class="hero-title text-dark mb-3" style="font-size: 72px;">
                Stories of <span style="color: #FC787D;">Joy & Art</span>
            </h1>
            <p class="fs-5 text-secondary" style="font-family: 'Inter', sans-serif;">Explore bespoke masterpieces brought to life for our cherished happy customers.</p>
        </div>
        <div class="hero-curve"></div>
    </section>

    <!-- Gallery Section -->
    <section class="gallery-container">
        <div class="container">
            
            <!-- Order Your Custom Art CTA Button -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Happy Customer Gallery</h3>
                    <p class="text-muted small mb-0">Browse custom artworks created by our artists</p>
                </div>
                <a href="/user/custom-art" class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm mt-2 mt-md-0" style="background-color: #111827;">
                    <i class="bi bi-palette-fill me-2" style="color: #FC787D;"></i> Order Your Custom Art
                </a>
            </div>

            <% if (customers && customers.length > 0) { %>
                <div class="row g-4">
                    <% customers.forEach(function(req) { %>
                        <% const customerName = toTitleCase(req.customer_name); %>
                        <% const artistName = req.artist_name ? toTitleCase(req.artist_name) : 'Not Assigned'; %>
                        <% const adminImages = req.gallery_images || []; %>

                        <div class="col-md-6 col-lg-4">
                            <div class="happy-art-card">
                                
                                <!-- Card Image Container (ONLY Admin Added Images displayed) -->
                                <div class="art-image-wrapper">
                                    <div class="art-badge-overlay">
                                        <span class="badge bg-dark rounded-pill px-3 py-2 shadow-sm"><%= req.size %></span>
                                        <span class="badge rounded-pill px-3 py-2 shadow-sm text-white" style="background-color: #FC787D;"><%= req.format %></span>
                                    </div>

                                    <% if (adminImages.length > 1) { %>
                                        <!-- Multi-image Admin Carousel -->
                                        <div id="carouselCard<%= req.request_id %>" class="carousel slide h-100" data-bs-ride="carousel">
                                            <div class="carousel-indicators">
                                                <% adminImages.forEach((img, idx) => { %>
                                                    <button type="button" data-bs-target="#carouselCard<%= req.request_id %>" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>"></button>
                                                <% }); %>
                                            </div>
                                            <div class="carousel-inner h-100">
                                                <% adminImages.forEach((img, idx) => { %>
                                                    <div class="carousel-item h-100 <%= idx === 0 ? 'active' : '' %>" data-bs-toggle="modal" data-bs-target="#artModal<%= req.request_id %>">
                                                        <img src="<%= img %>" class="art-image" alt="Artwork by Admin for <%= customerName %>">
                                                    </div>
                                                <% }); %>
                                            </div>
                                            <button class="carousel-control-prev card-carousel-control ms-2" type="button" data-bs-target="#carouselCard<%= req.request_id %>" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon" style="width: 14px; height: 14px;"></span>
                                            </button>
                                            <button class="carousel-control-next card-carousel-control me-2" type="button" data-bs-target="#carouselCard<%= req.request_id %>" data-bs-slide="next">
                                                <span class="carousel-control-next-icon" style="width: 14px; height: 14px;"></span>
                                            </button>
                                        </div>
                                    <% } else if (adminImages.length === 1) { %>
                                        <!-- Single Admin Added Image -->
                                        <div data-bs-toggle="modal" data-bs-target="#artModal<%= req.request_id %>" class="h-100">
                                            <img src="<%= adminImages[0] %>" class="art-image" alt="Artwork by Admin for <%= customerName %>">
                                        </div>
                                    <% } else { %>
                                        <!-- Placeholder when Admin image is not uploaded yet -->
                                        <div class="art-image d-flex flex-column align-items-center justify-content-center bg-light text-center p-3" data-bs-toggle="modal" data-bs-target="#artModal<%= req.request_id %>">
                                            <i class="bi bi-palette text-muted fs-1 mb-2"></i>
                                            <span class="small text-muted fw-semibold">Artwork Image Pending Upload by Admin</span>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="art-card-body">
                                    <h3 class="customer-name-heading" data-bs-toggle="modal" data-bs-target="#artModal<%= req.request_id %>" style="cursor: pointer;"><%= customerName %></h3>
                                    
                                    <div class="small text-muted mb-2">
                                        <i class="bi bi-calendar3 me-1"></i> <%= new Date(req.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    </div>

                                    <!-- Artist Name (Dynamically loaded) -->
                                    <div class="fw-bold mb-2" style="color: #4f46e5; font-size: 0.95rem;">
                                        <i class="bi bi-palette-fill me-1"></i> By - <%= artistName %>
                                    </div>

                                    <!-- Customer Rating Stars -->
                                    <div class="star-rating mb-3" style="color: #ffc107;">
                                        <% const rating = req.rating || 5; %>
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="bi bi-star-fill <%= i <= rating ? '' : 'text-secondary opacity-25' %>"></i>
                                        <% } %>
                                    </div>

                                    <!-- Dual Buttons in Single Row -->
                                    <div class="d-flex gap-2 mt-auto">
                                        <button type="button" class="btn btn-outline-secondary rounded-pill w-50 fw-bold py-2" style="font-size: 0.82rem;" data-bs-toggle="modal" data-bs-target="#refModal<%= req.request_id %>">
                                            <i class="bi bi-file-image me-1"></i> Reference Image
                                        </button>
                                        <button type="button" class="btn btn-dark rounded-pill w-50 fw-bold py-2" style="font-size: 0.82rem;" data-bs-toggle="modal" data-bs-target="#artModal<%= req.request_id %>">
                                            <i class="bi bi-eye-fill me-1"></i> View Details
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 1. Large Reference Image Modal Popup -->
                        <div class="modal fade" id="refModal<%= req.request_id %>" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                                    <div class="modal-header border-0 bg-dark text-white p-3 p-md-4">
                                        <h5 class="modal-title fw-bold mb-0">
                                            <i class="bi bi-file-image me-2 text-warning"></i>Customer Reference Image
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4 p-md-5 text-center">
                                        <div class="rounded-4 overflow-hidden shadow-sm border bg-light mb-3">
                                            <% if (req.reference_image) { %>
                                                <img src="<%= req.reference_image %>" class="w-100 object-fit-contain" style="max-height: 520px; background: #fafafa;" alt="Customer Reference Image">
                                            <% } else { %>
                                                <div class="p-5 text-muted">
                                                    <i class="bi bi-image fs-1 d-block mb-2"></i>
                                                    No reference image provided by customer.
                                                </div>
                                            <% } %>
                                        </div>
                                        <p class="fs-6 text-muted mb-0 fw-semibold">
                                            <i class="bi bi-info-circle me-1 text-primary"></i> This is the Image provided by the Customer.
                                        </p>
                                    </div>
                                    <div class="modal-footer border-0 bg-light p-3 justify-content-center">
                                        <button type="button" class="btn btn-dark rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Large Artwork Detail Modal (Admin Added Images) -->
                        <div class="modal fade" id="artModal<%= req.request_id %>" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-xl">
                                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                                    <div class="modal-header border-0 bg-dark text-white p-3 p-md-4 d-flex align-items-center justify-content-between">
                                        <h5 class="modal-title fw-bold mb-0">
                                            <i class="bi bi-stars text-warning me-2"></i>Custom Artwork Details
                                        </h5>
                                        <div class="d-flex align-items-center gap-2">
                                            <!-- Smooth transition: dismisses current modal while launching Reference Image Modal -->
                                            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#refModal<%= req.request_id %>">
                                                <i class="bi bi-file-image me-1"></i> View Reference Image
                                            </button>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                    </div>
                                    
                                    <div class="modal-body p-4 p-md-5" style="max-height: 78vh; overflow-y: auto;">
                                        <!-- Top Image Display (Admin Added Images Only) -->
                                        <div class="rounded-4 overflow-hidden shadow-sm border bg-light mb-4 position-relative mx-auto" style="max-width: 850px;">
                                            <% if (adminImages.length > 1) { %>
                                                <div id="carouselModal<%= req.request_id %>" class="carousel slide" data-bs-ride="carousel">
                                                    <div class="carousel-indicators">
                                                        <% adminImages.forEach((img, idx) => { %>
                                                            <button type="button" data-bs-target="#carouselModal<%= req.request_id %>" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>"></button>
                                                        <% }); %>
                                                    </div>
                                                    <div class="carousel-inner">
                                                        <% adminImages.forEach((img, idx) => { %>
                                                            <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                                                                <img src="<%= img %>" class="w-100 object-fit-contain" style="max-height: 460px; background: #fafafa;" alt="Custom Art Image">
                                                            </div>
                                                        <% }); %>
                                                    </div>
                                                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselModal<%= req.request_id %>" data-bs-slide="prev">
                                                        <span class="carousel-control-prev-icon bg-dark rounded-circle p-2"></span>
                                                    </button>
                                                    <button class="carousel-control-next" type="button" data-bs-target="#carouselModal<%= req.request_id %>" data-bs-slide="next">
                                                        <span class="carousel-control-next-icon bg-dark rounded-circle p-2"></span>
                                                    </button>
                                                </div>
                                            <% } else if (adminImages.length === 1) { %>
                                                <img src="<%= adminImages[0] %>" class="w-100 object-fit-contain" style="max-height: 460px; background: #fafafa;" alt="Custom Art Preview">
                                            <% } else { %>
                                                <div class="d-flex flex-column align-items-center justify-content-center p-5 text-muted" style="min-height: 250px;">
                                                    <i class="bi bi-palette fs-1 mb-2"></i>
                                                    <span class="fw-semibold">Artwork Image Pending Upload by Admin</span>
                                                </div>
                                            <% } %>
                                        </div>

                                        <!-- Information Displayed Below Image -->
                                        <div class="mx-auto text-start" style="max-width: 850px;">
                                            <h3 class="fw-bold text-dark mb-1"><%= customerName %></h3>
                                            
                                            <div class="small text-muted mb-2">
                                                <i class="bi bi-calendar3 me-1"></i> Date: <%= new Date(req.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            </div>

                                            <div class="fw-bold fs-6 mb-3" style="color: #4f46e5;">
                                                <i class="bi bi-palette-fill me-1"></i> By - <%= artistName %>
                                            </div>

                                            <!-- Specs Badges -->
                                            <div class="d-flex flex-wrap gap-2 mb-4">
                                                <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6"><%= req.size %> Size</span>
                                                <span class="badge rounded-pill px-3 py-2 text-white fs-6" style="background-color: #FC787D;"><%= req.format %></span>
                                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fs-6"><%= req.qty %> Subjects</span>
                                            </div>

                                            <!-- Sold in - Price -->
                                            <div class="d-flex align-items-center justify-content-between p-3 p-md-4 rounded-4 mb-4" style="background: rgba(252, 120, 125, 0.08); border: 1px dashed #FC787D;">
                                                <span class="fw-bold text-dark fs-5">Sold in -</span>
                                                <span class="fs-3 fw-bold text-dark">₹<%= Number(req.estimated_price).toLocaleString('en-IN') %></span>
                                            </div>

                                            <!-- Customer Feedback & Rating Stars -->
                                            <div class="p-3 p-md-4 bg-light rounded-4 mb-3 border">
                                                <div class="d-flex align-items-center mb-2">
                                                    <span class="fw-bold text-dark me-2">Feedback:</span>
                                                    <div class="star-rating" style="color: #ffc107;">
                                                        <% for (let i = 1; i <= 5; i++) { %>
                                                            <i class="bi bi-star-fill <%= i <= (req.rating || 5) ? '' : 'text-secondary opacity-25' %>"></i>
                                                        <% } %>
                                                    </div>
                                                </div>
                                                <div class="fst-italic text-dark fs-6" style="font-family: 'Inter', sans-serif;">
                                                    "<%= req.customer_review || req.description || 'Absolutely stunning custom portrait artwork!' %>"
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="modal-footer border-0 bg-light p-3">
                                        <button type="button" class="btn btn-dark rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="bi bi-stars empty-icon"></i>
                    <h3 class="fw-bold text-dark mb-3">No Artworks Featured Yet</h3>
                    <p class="text-secondary mb-4">Our gallery is currently being curated. Check back soon for beautiful custom art pieces from our customers!</p>
                    <a href="/user/custom-art" class="btn btn-dark rounded-pill px-4 py-2">Order Custom Art</a>
                </div>
            <% } %>
        </div>
    </section>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fenaria - <%= art.title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .art-details-img {
            height: 550px;
            object-fit: cover;
            border-radius: 12px;
        }
        @media (max-width: 768px) {
            .art-details-img {
                height: 350px;
            }
        }
        @media (max-width: 480px) {
            .art-details-img {
                height: 280px;
            }
        }
        .art-meta-badge {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            color: #495057;
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            display: inline-block;
            margin-right: 10px;
            margin-bottom: 10px;
        }
        .carousel-control-prev-icon, .carousel-control-next-icon {
            background-color: rgba(0, 0, 0, 0.5);
            border-radius: 50%;
            padding: 20px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="container py-5 mt-4">
        <div class="row">
            <!-- Left Column: Image Slider -->
            <div class="col-md-6 mb-4">
                <div id="artCarousel" class="carousel slide shadow-sm rounded" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <% art.images.forEach((img, index) => { %>
                            <button type="button" data-bs-target="#artCarousel" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" aria-label="Slide <%= index + 1 %>"></button>
                        <% }) %>
                    </div>
                    <div class="carousel-inner rounded" style="border-radius: 12px;">
                        <% art.images.forEach((img, index) => { %>
                            <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                <img src="<%= img %>" class="d-block w-100 art-details-img" alt="<%= art.title %>">
                            </div>
                        <% }) %>
                    </div>
                    <% if(art.images.length > 1) { %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#artCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#artCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                    <% } %>
                </div>
            </div>

            <!-- Right Column: Details -->
            <div class="col-md-6 px-lg-5">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/user/home" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><%= art.category %></li>
                  </ol>
                </nav>

                <h1 class="display-5 fw-bold mb-2" style="font-family: 'Inter', sans-serif;"><%= art.title %></h1>
                <p class="text-muted fs-5 mb-4">By <span class="fw-semibold text-dark"><%= art.artist_name %></span></p>

                <div class="d-flex align-items-center mb-4">
                    <h2 class="fw-bold mb-0 me-4" style="color: #2c3e50;">₹<%= art.price %></h2>
                    <div class="text-warning fs-5">
                        <i class="bi bi-star-fill"></i> <%= art.rating %>
                        <span class="text-muted fs-6 ms-2">(<%= art.total_reviews %> reviews)</span>
                    </div>
                </div>

                <div class="mb-4">
                    <% if(art.category) { %><span class="art-meta-badge"><i class="bi bi-tag me-1"></i><%= art.category %></span><% } %>
                    <% if(art.art_type) { %><span class="art-meta-badge"><i class="bi bi-palette me-1"></i><%= art.art_type %></span><% } %>
                    <% if(art.art_size) { %><span class="art-meta-badge"><i class="bi bi-arrows-fullscreen me-1"></i><%= art.art_size %></span><% } %>
                </div>

                <div class="mb-5">
                    <h5 class="fw-bold mb-3">Description</h5>
                    <p class="text-secondary lh-lg"><%= art.description %></p>
                </div>

                <div id="art-action-container" data-art-id="<%= art.art_id %>" data-stock="<%= art.stock %>">
                    <div class="spinner-border text-primary" role="status">
                      <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                
            </div>
        </div>

        <!-- Full Width Customer Reviews Section (Below Left & Right Columns) -->
        <div class="row mt-5 pt-4 border-top">
            <div class="col-12">
                <h2 class="section-title fs-1 mb-4 text-center">
                    <span class="section-highlight">Customer</span> Reviews
                </h2>
                <% if (reviews && reviews.length > 0) { %>
                    <div class="row g-4 justify-content-center">
                        <% reviews.forEach(review => { %>
                            <div class="col-md-6">
                                <div class="p-4 rounded-4 bg-white shadow-sm h-100" style="border: none !important; border-top: 4px solid #000000 !important;">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; font-weight: bold; font-size: 1.1rem;">
                                            <%= review.customer_name.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <div class="fw-bold fs-6"><%= review.customer_name %></div>
                                            <div class="text-warning small">
                                                <% for(let i=1; i<=5; i++) { %>
                                                    <i class="bi bi-star-fill <%= i <= review.rating ? '' : 'text-muted opacity-25' %>"></i>
                                                <% } %>
                                                <span class="text-muted ms-2 fst-italic small"><%= new Date(review.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                            </div>
                                        </div>
                                    </div>
                                    <% if (review.comment) { %>
                                        <p class="text-dark mb-0 ps-2" style="font-family: 'Caveat', cursive; font-size: 1.6rem; line-height: 1.3;">"<%= review.comment %>"</p>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="p-5 rounded-4 bg-light text-center border">
                        <i class="bi bi-star text-muted fs-1 mb-2"></i>
                        <p class="text-muted mb-0 fs-5">No reviews yet. Buy this masterpiece to be the first to review!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;">
        <div id="cartToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header text-white" id="toastHeader">
                <i class="bi bi-bell-fill me-2"></i>
                <strong class="me-auto" id="toastTitle">Notification</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="toastBody"></div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="/js/artDetails.js"></script>
</body>
</html>

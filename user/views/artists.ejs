<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fenaria - Our Artists</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background-color: #f8f9fa;">
<%- include('partials/navbar') %>

        <div class="container py-5">
            <div class="text-center mb-5">
                <h1 class="hero-title" style="font-family: 'Caveat', cursive; font-size: 3.5rem; color: #2C3E50;">Our Featured Artists
                </h1>
                <p class="text-muted">Discover the brilliant minds behind the masterpiece collection at Fenaria.</p>
            </div>

            <div class="row g-4 justify-content-center">
                <% if (artists && artists.length> 0) { %>
                    <% artists.forEach(artist=> { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 h-100 artist-card shadow-sm" style="border-radius: 20px; overflow: hidden; background: #ffffff;">
                                <% 
                                    const nameColors={ 'Male' : '1E3A8A,DBEAFE' , 'Female' : '9D174D,FCE7F3' }; 
                                    const colorSet=nameColors[artist.gender] || '374151,F3F4F6'; 
                                    const colors=colorSet.split(','); 
                                    const avatarUrl=`https://ui-avatars.com/api/?name=${encodeURIComponent(artist.artist_name)}&background=${colors[1]}&color=${colors[0]}&size=128&rounded=true&bold=true&length=1`;
                                %>
                                
                                <!-- Gradient Cover -->
                                <div style="height: 130px; background: linear-gradient(135deg, #<%= colors[0] %> 0%, #<%= colors[1] %> 100%); position: relative;">
                                    <!-- Floating Avatar -->
                                    <div style="position: absolute; bottom: -50px; left: 50%; transform: translateX(-50%);">
                                        <img src="<%= avatarUrl %>" alt="<%= artist.artist_name %>" class="rounded-circle shadow" style="width: 100px; height: 100px; border: 4px solid #ffffff; object-fit: cover; background-color: #fff;">
                                    </div>
                                </div>

                                <div class="card-body text-center" style="padding: 60px 30px 30px 30px;">
                                    <h4 class="fw-bold mb-1" style="color: #2C3E50; font-family: 'Playfair Display', serif;">
                                        <%= artist.artist_name %>
                                    </h4>
                                    
                                    <p class="text-muted small mb-3" style="font-weight: 500; text-transform: uppercase; letter-spacing: 1px;">
                                        <i class="bi bi-person-fill"></i> <%= artist.gender %>
                                    </p>
                                    
                                    <p class="text-secondary small mb-4 px-2" style="line-height: 1.6; min-height: 40px;">
                                        <%= artist.description || 'Passionate artist creating beautiful pieces.' %>
                                    </p>

                                    <div class="d-flex justify-content-center align-items-center mb-4">
                                        <span class="badge rounded-pill" style="background-color: #f8f9fa; color: #2C3E50; font-weight: 600; padding: 0.6em 1em; border: 1px solid #e9ecef;">
                                            <i class="bi bi-palette-fill me-2" style="color: #<%= colors[0] %>;"></i><%= artist.arts_count %> Masterpieces
                                        </span>
                                    </div>

                                    <div class="d-flex justify-content-center gap-4">
                                        <a href="#" class="social-icon" style="color: #<%= colors[0] %>;"><i class="bi bi-instagram"></i></a>
                                        <a href="#" class="social-icon" style="color: #<%= colors[0] %>;"><i class="bi bi-facebook"></i></a>
                                        <a href="#" class="social-icon" style="color: #<%= colors[0] %>;"><i class="bi bi-twitter-x"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="col-12 text-center py-5">
                                    <i class="bi bi-brush text-muted mb-3" style="font-size: 3rem;"></i>
                                    <h4 class="text-muted">No artists found at the moment.</h4>
                                </div>
                                <% } %>
            </div>
        </div>

        <style>
            .artist-card {
                transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }
            .artist-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12) !important;
            }
            .social-icon {
                font-size: 1.3rem;
                transition: transform 0.2s ease, opacity 0.2s ease;
                opacity: 0.7;
            }
            .social-icon:hover {
                transform: scale(1.2) translateY(-2px);
                opacity: 1;
            }
        </style>

        <%- include('partials/footer') %>
    </body>
</html>